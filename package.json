{
  "name": "opsdesk",
  "version": "0.1.0",
  "private": true,
  "description": "Travel-aware operations ticketing system (PERN)",
  "workspaces": [
    "api"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev --workspace api",
    "worker": "npm run worker --workspace api",
    "migrate": "npm run migrate --workspace api",
    "seed": "npm run seed --workspace api",
    "test": "npm test --workspace api",
    "lint": "npm run lint --workspace api && prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
