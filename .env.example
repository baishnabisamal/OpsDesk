# Copy to .env (make setup does this) and change the password.
# .env is git-ignored. Never commit real secrets.

# PostgreSQL: this user owns the schema and runs migrations.
POSTGRES_USER=opsdesk_owner
POSTGRES_PASSWORD=change-me
POSTGRES_DB=opsdesk
POSTGRES_PORT=5432

# Redis. 6380 on the host, because 6379 is often taken by another project.
REDIS_PORT=6380

# Mailpit: catches outgoing email. Web inbox at http://localhost:8025
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
