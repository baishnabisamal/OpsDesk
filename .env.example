# Copy to .env (make setup does this) and change the password.
# .env is git-ignored. Never commit real secrets.

# PostgreSQL: this user owns the schema and runs migrations.
POSTGRES_USER=opsdesk_owner
POSTGRES_PASSWORD=change-me
POSTGRES_DB=opsdesk
POSTGRES_PORT=5432

# Redis. 6380 on the host, because 6379 is often taken by another project.
REDIS_PORT=6380

# Mailpit: catches outgoing email. Web inbox at http://localhost:8025
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# API
API_PORT=3000
LOG_LEVEL=info

# The API logs in to Postgres as this role. It owns nothing and cannot
# bypass Row-Level Security. `make migrate` sets this password on the role.
APP_DB_USER=opsdesk_app
APP_DB_PASSWORD=change-me-too

# Signs access tokens. At least 32 characters.
# Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more

# ML service (Python). The API calls it to suggest a ticket intent.
# Both sides must have the same shared secret (at least 16 characters).
ML_URL=http://127.0.0.1:8001
ML_SHARED_SECRET=change-me-ml-shared-secret
ML_TIMEOUT_MS=150

# Email. The worker sends through Mailpit locally.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM=OpsDesk Support <support@opsdesk.local>
INBOUND_DOMAIN=inbound.opsdesk.local
# Signs the inbound email webhook. At least 32 characters: openssl rand -hex 32
INBOUND_WEBHOOK_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more

# WebSocket gateway
REALTIME_PORT=3001

# Archive files of old ticket history, and how many months stay in PostgreSQL
ARCHIVE_DIR=../var/archive
ARCHIVE_RETENTION_MONTHS=12
