{
  "uid": "opsdesk-api",
  "title": "OpsDesk API",
  "schemaVersion": 39,
  "time": { "from": "now-30m", "to": "now" },
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests per second, by route",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(http_requests_total[1m]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Errors per second (5xx)",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(http_requests_total{status=~\"5..\"}[1m]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "p95 duration (seconds), by route",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Outbox lag (seconds)",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "outbox_lag_seconds", "legendFormat": "oldest unpublished event" },
        { "refId": "B", "expr": "outbox_unpublished_events", "legendFormat": "unpublished events" }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Tickets in triage",
      "gridPos": { "x": 0, "y": 16, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "tickets_in_triage" }]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Live tickets past SLA",
      "gridPos": { "x": 6, "y": 16, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "tickets_sla_breached" }]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Agent load drift (must be 0)",
      "gridPos": { "x": 12, "y": 16, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "agent_load_drift" }]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Database pool",
      "gridPos": { "x": 18, "y": 16, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "db_pool_connections", "legendFormat": "{{state}}" }]
    }
  ]
}
