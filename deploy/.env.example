# Settings for the deployed system. Copy to deploy/.env (git-ignored), or run
#   ./deploy/init-env.sh <site-address>
# which fills in random secrets for you. Never commit the real file.

# --- Where the site lives -----------------------------------------------------
# A host name that points at this server. Without your own domain, sslip.io
# gives you one for free: the server's IP with dashes, e.g. 203.0.113.10 ->
#   opsdesk.203-0-113-10.sslip.io
# Caddy gets the HTTPS certificate for it on its own.
SITE_ADDRESS=opsdesk.203-0-113-10.sslip.io
# Links in emails (verify, reset, invite) point here. Same host, with https://
APP_URL=https://opsdesk.203-0-113-10.sslip.io

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_DB=opsdesk
POSTGRES_USER=opsdesk_owner
POSTGRES_PASSWORD=change-me
# The API's own login (owns nothing, cannot bypass Row-Level Security).
APP_DB_PASSWORD=change-me-too

# --- Secrets (each: openssl rand -hex 32) -------------------------------------
JWT_SECRET=change-me
ML_SHARED_SECRET=change-me
INBOUND_WEBHOOK_SECRET=change-me

# --- Email --------------------------------------------------------------------
# A real SMTP provider. Brevo's free plan (300 emails a day) works without a
# domain: verify one sender address in Brevo, then use it in MAIL_FROM.
#   Brevo -> SMTP & API -> SMTP: host, port, login and an SMTP key.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=OpsDesk Support <you@example.com>

# --- Public demo --------------------------------------------------------------
# true = the login page lists the seeded demo accounts and their password.
# Only for a demo whose database holds nothing but seed data.
DEMO_LOGINS=false

# --- Optional -----------------------------------------------------------------
LOG_LEVEL=info
# How long ticket create waits for the ML service before using the fallback.
ML_TIMEOUT_MS=150
