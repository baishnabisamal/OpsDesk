# Caddy: the only container reachable from the internet.
#
# SITE_ADDRESS is a host name (for example opsdesk.203-0-113-10.sslip.io).
# Caddy then gets an HTTPS certificate from Let's Encrypt by itself, renews it,
# and redirects http:// to https://. For a test on a laptop, set it to
# http://localhost to serve plain HTTP with no certificate.
{$SITE_ADDRESS} {
	encode zstd gzip

	# Prometheus metrics are for the internal network only (README section 13).
	# Inside its own handle block: a bare `respond` runs after the `handle`
	# blocks in Caddy's directive order, so the catch-all below answered first
	# (found by the CI smoke test, which expects 404 here).
	@internal path /metrics /metrics/*
	handle @internal {
		respond 404
	}

	# The API. Caddy adds X-Forwarded-For with the visitor's address and drops
	# any value the visitor sent, so the API (TRUST_PROXY=1) can trust it.
	@api path /api/* /healthz /readyz /openapi.json
	handle @api {
		reverse_proxy api:3000
	}

	# Live updates. Caddy passes the WebSocket upgrade through as it is.
	handle /socket.io/* {
		reverse_proxy realtime:3001
	}

	# Everything else is the React app. Unknown paths get index.html, so a
	# reload on /tickets/123 opens the app, and React Router shows the page.
	handle {
		root * /srv
		# File names under /assets contain a hash of their content, so a
		# browser may keep them for a year; index.html is checked every time.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	header {
		# Only this site's own scripts, styles, fonts and connections.
		# 'unsafe-inline' for styles only: React sets style="width: 40%" on bars.
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}
